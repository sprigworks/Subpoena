{#- Generates TypeScript constants from the Subpoena registry. Output: generated/ts/semconv.ts -#}
// Code generated by Weaver from registry/; DO NOT EDIT.
// Regenerate with `make generate`.

// Span names and attribute keys of the Subpoena registry, plus the
// per-attribute export tier.

// Span names.
{%- for span in ctx.spans %}

/** {{ span.brief | trim | replace("\n", " ") }} */
export const SPAN_{{ span.name | screaming_snake_case }} = "{{ span.name }}";
{%- endfor %}

// Attribute keys.
{%- for attr in ctx.attributes %}

/** {{ attr.brief | trim | replace("\n", " ") }} */
export const ATTR_{{ attr.name | screaming_snake_case }} = "{{ attr.name }}";
{%- endfor %}

// Enum members: the allowed values of enum-typed attributes. Their values are
// not telemetry names; reference them instead of writing the string.
{%- for attr in ctx.attributes %}
{%- if attr.type is mapping %}
{%- for m in attr.type.members %}

/** {{ m.brief | trim | replace("\n", " ") }} */
export const VAL_{{ attr.name | screaming_snake_case }}_{{ m.id | screaming_snake_case }} = "{{ m.value }}";
{%- endfor %}
{%- endif %}
{%- endfor %}

/** Where an attribute may be exported. */
export type Tier = "test" | "all";

/** TIER_TEST attributes are never exported in production. */
export const TIER_TEST: Tier = "test";
/** TIER_ALL attributes are exported everywhere. */
export const TIER_ALL: Tier = "all";

/** Every registry attribute used by a registry span, mapped to its tier. */
export const ATTRIBUTE_TIERS: Readonly<Record<string, Tier>> = {
{%- for attr in ctx.attributes %}
  [ATTR_{{ attr.name | screaming_snake_case }}]: TIER_{{ (attr.annotations.tier | default("test")) | screaming_snake_case }},
{%- endfor %}
};
